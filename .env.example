# NASA Open Data API (https://api.nasa.gov)
# Used server-side for DONKI space-weather data. EONET needs no key.
# Get your own key at https://api.nasa.gov and keep it out of version control.
NASA_API_KEY=

# Optional OpenSky OAuth credentials (anonymous access works with a small quota).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
